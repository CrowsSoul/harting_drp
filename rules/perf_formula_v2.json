{
  "schema_version": "2.0.0",
  "name": "harting_perf_formula_rules",
  "version": "2.0.0",
  "models": {
    "PERF-01": {
      "id": "perf01_electrothermal_steady_v2",
      "title": "载流导体稳态电热耦合",
      "analysis_type": "steady_electrothermal",
      "source": {
        "basis": [
          "NX Check-Mate Evaluate Conditional Expression: comparison operators and equality tolerance",
          "NX 2606 Thermal Flow/TMG: steady thermal network with convection, radiation and temperature-dependent material conductance",
          "NX Nastran thermal sample: temperature-dependent radiation boundary"
        ],
        "evidence_note": "NX formula/comparison semantics reproduced; contact resistance remains a local calibrated term and is not claimed as NX output.",
        "reference_path": "docs/NX_PERF_RULE_EVIDENCE.md",
        "evidence_machine": "rules/nx_rule_evidence_v1.json#/rule_mapping/PERF-01",
        "confidence": "formula_and_local_verification"
      },
      "inputs": {
        "area_mm2": {"unit": "mm^2", "source": "minimum conductor cylindrical face section"},
        "length_mm": {"unit": "mm", "source": "cylindrical face lateral area / circumference"},
        "rho_ohm_m": {"unit": "ohm*m", "source": "material.rho_ohm_m"},
        "temp_coeff_per_c": {"unit": "1/K", "source": "material.temp_coeff_per_c"},
        "current_a": {"unit": "A", "source": "working condition"},
        "ambient_temp_c": {"unit": "degC", "source": "working condition"},
        "h_w_m2k": {"unit": "W/(m^2*K)", "source": "convection boundary condition"},
        "emissivity": {"unit": "1", "source": "surface radiation boundary condition"},
        "contact_resistance_ohm_mm2": {"unit": "ohm*mm^2", "source": "local calibrated contact term"},
        "reference_temp_c": {"unit": "degC", "source": "material resistivity reference temperature"},
        "max_solver_rise_c": {"unit": "degC", "source": "numerical root bracket, not a design limit"},
        "max_rise_c": {"unit": "degC", "source": "design limit"},
        "max_temperature_c": {"unit": "degC", "source": "absolute temperature limit"}
      },
      "constants": {
        "sigma_w_m2k4": 5.670374419e-8,
        "kelvin_offset": 273.15
      },
      "variables": {
        "area_m2": {
          "unit": "m^2",
          "expression": "area_mm2 * 1e-6"
        },
        "length_m": {
          "unit": "m",
          "expression": "length_mm * 1e-3"
        },
        "diameter_m": {
          "unit": "m",
          "expression": "2 * sqrt(area_m2 / pi)"
        },
        "surface_area_m2": {
          "unit": "m^2",
          "expression": "pi * diameter_m * length_m + 2 * area_m2"
        },
        "rho_hot_ohm_m": {
          "unit": "ohm*m",
          "expression": "rho_ohm_m * max(0.5, 1 + temp_coeff_per_c * (temperature_c - reference_temp_c))"
        },
        "body_resistance_ohm": {
          "unit": "ohm",
          "expression": "rho_hot_ohm_m * length_m / area_m2"
        },
        "contact_resistance_ohm": {
          "unit": "ohm",
          "expression": "contact_resistance_ohm_mm2 / area_mm2"
        },
        "total_resistance_ohm": {
          "unit": "ohm",
          "expression": "body_resistance_ohm + contact_resistance_ohm"
        },
        "power_w": {
          "unit": "W",
          "expression": "current_a**2 * total_resistance_ohm"
        },
        "voltage_drop_v": {
          "unit": "V",
          "expression": "current_a * total_resistance_ohm"
        },
        "convection_w": {
          "unit": "W",
          "expression": "h_w_m2k * surface_area_m2 * (temperature_c - ambient_temp_c)"
        },
        "radiation_w": {
          "unit": "W",
          "expression": "emissivity * sigma_w_m2k4 * surface_area_m2 * ((temperature_c + kelvin_offset)**4 - (ambient_temp_c + kelvin_offset)**4)"
        },
        "temperature_residual_w": {
          "unit": "W",
          "expression": "power_w - convection_w - radiation_w"
        },
        "delta_t_c": {
          "unit": "degC",
          "expression": "temperature_c - ambient_temp_c"
        },
        "absolute_temperature_c": {
          "unit": "degC",
          "expression": "temperature_c"
        }
      },
      "solve": {
        "unknown": "temperature_c",
        "equation": "temperature_residual_w",
        "lower": "ambient_temp_c",
        "upper": "ambient_temp_c + max_solver_rise_c",
        "absolute_tolerance": 1e-7,
        "max_iterations": 96
      },
      "decisions": [
        {
          "id": "temperature_rise_limit",
          "condition": "delta_t_c >= max_rise_c",
          "margin": "max_rise_c - delta_t_c",
          "unit": "degC",
          "severity": "P2",
          "rounding_digits": 6,
          "message": "稳态温升超过允许值"
        },
        {
          "id": "absolute_temperature_limit",
          "condition": "absolute_temperature_c >= max_temperature_c",
          "margin": "max_temperature_c - absolute_temperature_c",
          "unit": "degC",
          "severity": "P2",
          "rounding_digits": 6,
          "message": "导体绝对温度超过允许值"
        }
      ],
      "limitations": [
        "单圆柱导体、稳态、均温节点模型",
        "不含壳体导热、端子镀层、邻近导体和强制风场分布",
        "contact_resistance_ohm_mm2 是本地标定项，需用 NX/实测结果复核"
      ],
      "confidence_level": "low",
      "confidence_basis": "降阶电热公式，未经 CAE 认证样本校验；接触电阻为本地标定项"
    },
    "PERF-02": {
      "id": "perf02_cantilever_contact_v2",
      "title": "接触簧片插拔力",
      "analysis_type": "structural_contact_static",
      "source": {
        "basis": [
          "NX Nastran contact definition: surface pair, friction coefficient, search distance and penalty contact",
          "Euler-Bernoulli cantilever small-deflection mechanics",
          "Coulomb friction cone and lead-angle force equilibrium"
        ],
        "evidence_note": "The efficient checker uses the reduced-order formula. A nonlinear NX solver result is required before using it outside the documented small-deflection scope.",
        "reference_path": "docs/NX_PERF_RULE_EVIDENCE.md",
        "evidence_machine": "rules/nx_rule_evidence_v1.json#/rule_mapping/PERF-02",
        "confidence": "formula_and_local_verification"
      },
      "inputs": {
        "length_mm": {"unit": "mm", "source": "contact spring metadata"},
        "width_mm": {"unit": "mm", "source": "contact spring metadata"},
        "thickness_mm": {"unit": "mm", "source": "contact spring metadata"},
        "overlap_mm": {"unit": "mm", "source": "contact spring metadata"},
        "e_gpa": {"unit": "GPa", "source": "material.e_gpa"},
        "contacts": {"unit": "1", "source": "contact spring metadata"},
        "lead_angle_deg": {"unit": "deg", "source": "contact spring metadata"},
        "friction_coeff": {"unit": "1", "source": "contact pair metadata"},
        "insertion_force_max_n": {"unit": "N", "source": "design limit"},
        "withdrawal_force_min_n": {"unit": "N", "source": "design limit"}
      },
      "constants": {},
      "variables": {
        "length_m": {
          "unit": "m",
          "expression": "length_mm * 1e-3"
        },
        "width_m": {
          "unit": "m",
          "expression": "width_mm * 1e-3"
        },
        "thickness_m": {
          "unit": "m",
          "expression": "thickness_mm * 1e-3"
        },
        "overlap_m": {
          "unit": "m",
          "expression": "overlap_mm * 1e-3"
        },
        "e_pa": {
          "unit": "Pa",
          "expression": "e_gpa * 1e9"
        },
        "second_moment_m4": {
          "unit": "m^4",
          "expression": "width_m * thickness_m**3 / 12"
        },
        "spring_stiffness_n_m": {
          "unit": "N/m",
          "expression": "3 * e_pa * second_moment_m4 / length_m**3"
        },
        "normal_force_n": {
          "unit": "N",
          "expression": "spring_stiffness_n_m * overlap_m"
        },
        "lead_tangent": {
          "unit": "1",
          "expression": "tan(radians(lead_angle_deg))"
        },
        "lead_denominator": {
          "unit": "1",
          "expression": "1 - friction_coeff * lead_tangent"
        },
        "lead_factor": {
          "unit": "1",
          "expression": "(friction_coeff + lead_tangent) / lead_denominator"
        },
        "insertion_force_n": {
          "unit": "N",
          "expression": "contacts * normal_force_n * lead_factor"
        },
        "withdrawal_force_n": {
          "unit": "N",
          "expression": "contacts * normal_force_n * friction_coeff"
        },
        "friction_cone_ratio": {
          "unit": "1",
          "expression": "friction_coeff * normal_force_n / max(abs(withdrawal_force_n), 1e-12)"
        },
        "insertion_margin_n": {
          "unit": "N",
          "expression": "insertion_force_max_n - insertion_force_n"
        },
        "withdrawal_margin_n": {
          "unit": "N",
          "expression": "withdrawal_force_n - withdrawal_force_min_n"
        }
      },
      "decisions": [
        {
          "id": "insertion_upper",
          "condition": "insertion_force_n >= insertion_force_max_n",
          "margin": "insertion_margin_n",
          "unit": "N",
          "severity": "P2",
          "rounding_digits": 6,
          "message": "插入力达到或超过上限"
        },
        {
          "id": "withdrawal_lower",
          "condition": "withdrawal_force_n < withdrawal_force_min_n",
          "margin": "withdrawal_margin_n",
          "unit": "N",
          "severity": "P3",
          "rounding_digits": 6,
          "message": "拔出力低于下限"
        }
      ],
      "limitations": [
        "等效单根等截面悬臂簧片，小变形、线弹性",
        "摩擦系数为常数，未覆盖塑性、磨损、二次插拔和壳体导向",
        "过盈量及簧片尺寸必须来自接触特征元数据，不使用零件包围盒猜测"
      ],
      "confidence_level": "low",
      "confidence_basis": "降阶悬臂梁+摩擦公式，未经 CAE 接触求解认证样本校验"
    }
  }
}
