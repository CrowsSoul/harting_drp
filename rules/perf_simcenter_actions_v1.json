      "selection_requirements": [
        "spring fixed-root faces",
        "target insertion/withdrawal driven faces",
        "contact source faces",
        "contact target faces"
      ],
      "operations": [
        "assign linear-elastic material",
        "create tetrahedral or hexahedral structural mesh with contact refinement",
        "fix the spring root in all degrees of freedom",
